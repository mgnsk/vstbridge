--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
@@ -5161,6 +5161,49 @@ void OpDispatchBuilder::BreakOp(OpcodeArgs, FEXCore::IR::BreakDefinition BreakDe
   }
 }
 
+// x86 execute breakpoints: emitted before an instruction whose address is in the context's
+// breakpoint set. Raises #DB (a hardware breakpoint, before the instruction runs) if one of this
+// thread's enabled Dr0-Dr3 slots points at it, unless the resume flag skips it this once.
+void OpDispatchBuilder::ExecuteBreakpointCheck(int64_t RIPOffset) {
+  const auto GPRSize = GetGPROpSize();
+
+  CalculateDeferredFlags();
+  FlushRegisterCache();
+
+  Ref Address = _EntrypointOffset(GPRSize, RIPOffset);
+  Ref Hit = Constant(0);
+  for (size_t i = 0; i < 4; ++i) {
+    Ref Breakpoint = _LoadContextGPR(OpSize::i64Bit, offsetof(FEXCore::Core::CPUState, execute_breakpoints[i]));
+    Hit = _Or(OpSize::i64Bit, Hit, _Select(OpSize::i64Bit, OpSize::i64Bit, CondClass::EQ, Breakpoint, Address, Constant(1), Constant(0)));
+  }
+  Ref ResumeRIP = _LoadContextGPR(OpSize::i64Bit, offsetof(FEXCore::Core::CPUState, breakpoint_resume_rip));
+  Ref Trap = _Select(OpSize::i64Bit, OpSize::i64Bit, CondClass::EQ, ResumeRIP, Address, Constant(0), Hit);
+
+  auto TrapCond = CondJump(Trap);
+
+  auto CurrentBlock = GetCurrentBlock();
+  auto TrapBlock = CreateNewCodeBlockAtEnd();
+  SetTrueJumpTarget(TrapCond, TrapBlock);
+  SetCurrentCodeBlock(TrapBlock);
+  StartNewBlock();
+
+  _StoreContextGPR(GPRSize, _EntrypointOffset(GPRSize, RIPOffset), offsetof(FEXCore::Core::CPUState, rip));
+  Break(FEXCore::IR::BreakDefinition {
+    .ErrorRegister = 0,
+    .Signal = Core::FAULT_SIGTRAP,
+    .TrapNumber = X86State::X86_TRAPNO_DB,
+    .si_code = 4, // TRAP_HWBKPT
+  });
+
+  auto NextBlock = CreateNewCodeBlockAfter(CurrentBlock);
+  SetFalseJumpTarget(TrapCond, NextBlock);
+  SetCurrentCodeBlock(NextBlock);
+  StartNewBlock();
+
+  // RF only lasts for one instruction
+  _StoreContextGPR(OpSize::i64Bit, Constant(0), offsetof(FEXCore::Core::CPUState, breakpoint_resume_rip));
+}
