+// x86 debug registers as the program set them. Wine's ARM64EC context conversion has no room for
+// them, so Wine passes them to SetThreadDebugContext and reads them with GetThreadDebugContext.
+struct DebugRegisters {
+  uint64_t Dr[4] {};
+  uint64_t Dr6 {};
+  uint64_t Dr7 {};
+};
+
 struct FrontendThreadData {
   bool InLockedRWXRead {};
+  DebugRegisters Debug {};
+  // Where the last execute breakpoint trapped, so that its exception context reports RF
+  uint64_t BreakpointHitRIP {};
 };
 
 namespace {
@@ -167,6 +178,58 @@ FrontendThreadData* GetFrontendThreadData(FEXCore::Core::InternalThreadState* Th
   return static_cast<FrontendThreadData*>(Thread->FrontendPtr);
 }
 
+// Debug registers set on threads of this process that haven't run ThreadInit yet, by TID.
+// `ThreadCreationMutex` must be locked when accessing
+std::unordered_map<DWORD, DebugRegisters> PendingDebugRegisters;
+
+// The FEX state and TID of a thread of this process (the state is nullptr if the thread hasn't
+// started yet), or a TID of 0 for a thread of another process. `ThreadCreationMutex` must be locked.
+std::pair<FEXCore::Core::InternalThreadState*, DWORD> LookupThread(HANDLE Thread) {
+  THREAD_BASIC_INFORMATION Info;
+  if (NtQueryInformationThread(Thread, ThreadBasicInformation, &Info, sizeof(Info), nullptr) ||
+      reinterpret_cast<uintptr_t>(Info.ClientId.UniqueProcess) != GetCurrentProcessId()) {
+    return {nullptr, 0};
+  }
+  const auto TID = static_cast<DWORD>(reinterpret_cast<uintptr_t>(Info.ClientId.UniqueThread));
+  const auto It = Threads.find(TID);
+  return {It != Threads.end() ? It->second : nullptr, TID};
+}
+
+// Gives the JIT the enabled execute breakpoints (R/W=00) of Dr0-Dr3 and makes it check their
+// addresses. Data breakpoints aren't emulated. `ThreadCreationMutex` must be locked.
+void ApplyDebugRegisters(FEXCore::Core::InternalThreadState* Thread, const DebugRegisters& Debug) {
+  for (size_t i = 0; i < 4; i++) {
+    const bool Enabled = (Debug.Dr7 >> (i * 2)) & 3;
+    const bool Execute = ((Debug.Dr7 >> (16 + i * 4)) & 3) == 0;
+    const uint64_t Address = Enabled && Execute ? Debug.Dr[i] : 0;
+
+    Thread->CurrentFrame->State.execute_breakpoints[i] = Address;
+    if (!Address) {
+      continue;
+    }
+
+    bool Added;
+    {
+      std::scoped_lock Lock(CTX->GetCodeInvalidationMutex());
+      Added = CTX->AddExecuteBreakpoint(Address);
+    }
+    if (Added && InvalidationTracker) {
+      // Code compiled there before has no check
+      InvalidationTracker->InvalidateAlignedInterval(Address, 1, false);
+    }
+  }
+}
+
+void FillDebugContext(const DebugRegisters& Debug, CONTEXT* Context) {
+  Context->ContextFlags |= CONTEXT_DEBUG_REGISTERS;
+  Context->Dr0 = Debug.Dr[0];
+  Context->Dr1 = Debug.Dr[1];
+  Context->Dr2 = Debug.Dr[2];
+  Context->Dr3 = Debug.Dr[3];
+  Context->Dr6 = Debug.Dr6;
+  Context->Dr7 = Debug.Dr7;
+}
+
 bool IsEmulatorStackAddress(const ThreadCPUArea CPUArea, uint64_t Address) {
