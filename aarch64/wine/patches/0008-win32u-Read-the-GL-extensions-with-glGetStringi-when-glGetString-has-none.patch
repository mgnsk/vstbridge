From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rations <ehqcar@proton.me>
Date: Sat, 17 Oct 2026 12:28:50 +1000
Subject: [PATCH] win32u: Read the GL extensions with glGetStringi() when
 glGetString() has none.

OpenGL 3.1 and later contexts without the compatibility profile return NULL for
glGetString(GL_EXTENSIONS). Mesa's V3D driver (Raspberry Pi 4 and 5) offers only such contexts,
so init_device_info(), which picks the first context it can create, passed NULL to
parse_extensions() and crashed in explorer.exe's first NtUserCreateWindowEx(), while
lock_display_devices() held display_lock. The lock was never released, and every program that
then created a window, and explorer itself, waited for it forever. 11.18 tolerated the NULL
through has_extension().

parse_current_extensions() now uses glGetString() only when it returns the extensions, and
glGetStringi() otherwise, and init_device_info() uses it.
---
 dlls/win32u/opengl.c | 31 +++++++++++++++++++------------
 1 file changed, 19 insertions(+), 12 deletions(-)

diff --git a/dlls/win32u/opengl.c b/dlls/win32u/opengl.c
index 5267f75b711..29eb73ca0ec 100644
--- a/dlls/win32u/opengl.c
+++ b/dlls/win32u/opengl.c
@@ -237,21 +237,28 @@ static const char *parse_version( const char *version, int *major, int *minor )
 static void parse_current_extensions( int major, BOOLEAN extensions[GL_EXTENSION_COUNT] )
 {
     const struct opengl_funcs *funcs = &display_funcs;
+    GLint extensions_count = 0;
+    const char *str;
 
-    if (major >= 3)
+    /* OpenGL 3.1 and later contexts without the compatibility profile, such as the only ones
+     * Mesa's V3D driver (Raspberry Pi) offers, return NULL for GL_EXTENSIONS through
+     * glGetString(), so read them with glGetStringi() then. */
+    if (major < 3 && (str = (const char *)funcs->p_glGetString( GL_EXTENSIONS )))
     {
-        GLint extensions_count;
-        funcs->p_glGetIntegerv( GL_NUM_EXTENSIONS, &extensions_count );
-        for (GLint i = 0; i < extensions_count; i++)
-        {
-            const char *name = (const char *)funcs->p_glGetStringi( GL_EXTENSIONS, i );
-            enum opengl_extension ext = parse_extension( name, strlen( name ) );
-            if (ext != GL_EXTENSION_COUNT) extensions[ext] = TRUE;
-        }
+        parse_extensions( str, extensions, TRUE );
+        return;
     }
-    else
+
+    if (!funcs->p_glGetStringi) return;
+    funcs->p_glGetIntegerv( GL_NUM_EXTENSIONS, &extensions_count );
+    for (GLint i = 0; i < extensions_count; i++)
     {
-        parse_extensions( (const char *)funcs->p_glGetString( GL_EXTENSIONS ), extensions, TRUE );
+        const char *name = (const char *)funcs->p_glGetStringi( GL_EXTENSIONS, i );
+        enum opengl_extension ext;
+
+        if (!name) continue;
+        ext = parse_extension( name, strlen( name ) );
+        if (ext != GL_EXTENSION_COUNT) extensions[ext] = TRUE;
     }
 }
 
@@ -1886,7 +1893,7 @@ static void init_device_info( struct egl_platform *egl, const struct opengl_func
             memcpy( egl->version, values, sizeof(egl->version) );
         TRACE( "  - version: %u.%u.%u\n", egl->version[0], egl->version[1], egl->version[2] );
 
-        parse_extensions( (const char *)funcs->p_glGetString( GL_EXTENSIONS ), extensions, TRUE );
+        parse_current_extensions( 0, extensions );
         if (extensions[GL_NVX_gpu_memory_info])
         {
             funcs->p_glGetIntegerv( GL_GPU_MEMORY_INFO_DEDICATED_VIDMEM_NVX, values );
