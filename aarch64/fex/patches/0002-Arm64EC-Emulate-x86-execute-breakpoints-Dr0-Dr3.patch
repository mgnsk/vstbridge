+// Called by Wine's ARM64EC NtSetContextThread, NtContinue and NtContinueEx (a vstbridge wine-fex
+// patch) with the x64 context: takes Dr0-Dr3, Dr6 and Dr7, and RF from EFlags.
+void SetThreadDebugContext(HANDLE Thread, const CONTEXT* Context) {
+  const bool SetsDebug = (Context->ContextFlags & CONTEXT_DEBUG_REGISTERS) == CONTEXT_DEBUG_REGISTERS;
+  const bool SetsControl = (Context->ContextFlags & CONTEXT_CONTROL) == CONTEXT_CONTROL;
+  if (!SetsDebug && !SetsControl) {
+    return;
+  }
+
+  std::scoped_lock Lock(ThreadCreationMutex);
+  const auto [ThreadState, TID] = LookupThread(Thread);
+  if (!TID) {
+    return;
+  }
+
+  if (SetsDebug) {
+    const DebugRegisters Debug {
+      .Dr = {Context->Dr0, Context->Dr1, Context->Dr2, Context->Dr3},
+      .Dr6 = Context->Dr6,
+      .Dr7 = Context->Dr7,
+    };
+    if (ThreadState) {
+      GetFrontendThreadData(ThreadState)->Debug = Debug;
+      ApplyDebugRegisters(ThreadState, Debug);
+    } else {
+      PendingDebugRegisters[TID] = Debug;
+    }
+  }
+
+  if (SetsControl && ThreadState) {
+    ThreadState->CurrentFrame->State.breakpoint_resume_rip = (Context->EFlags & 0x10000) ? Context->Rip : 0;
+  }
+}
+
+// Called by Wine's ARM64EC NtGetContextThread when the debug registers are asked for
+void GetThreadDebugContext(HANDLE Thread, CONTEXT* Context) {
+  std::scoped_lock Lock(ThreadCreationMutex);
+  const auto [ThreadState, TID] = LookupThread(Thread);
+  if (!TID) {
+    return;
+  }
+
+  DebugRegisters Debug {};
+  if (ThreadState) {
+    Debug = GetFrontendThreadData(ThreadState)->Debug;
+  } else if (auto It = PendingDebugRegisters.find(TID); It != PendingDebugRegisters.end()) {
+    Debug = It->second;
+  }
+  FillDebugContext(Debug, Context);
+}
+
