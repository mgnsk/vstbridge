+bool ContextImpl::AddExecuteBreakpoint(uint64_t Address) {
+  LogMan::Throw::AFmt(CodeInvalidationMutex.try_lock() == false, "CodeInvalidationMutex needs to be unique_locked here");
+
+  const bool Added = ExecuteBreakpoints.insert(Address).second;
+  HasExecuteBreakpoints.store(true, std::memory_order_relaxed);
+  return Added;
+}
+
+bool ContextImpl::HasExecuteBreakpointInRange(uint64_t Address, uint64_t Size) const {
+  if (!HasExecuteBreakpoints.load(std::memory_order_relaxed)) {
+    return false;
+  }
+  auto It = ExecuteBreakpoints.lower_bound(Address);
+  return It != ExecuteBreakpoints.end() && *It < Address + Size;
+}
+
 void ContextImpl::MarkMonoBackpatcherBlock(uint64_t BlockEntry) {
   MonoBackpatcherBlock.store(BlockEntry, std::memory_order_relaxed);
 }
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
